{
  "name": "mathpath",
  "version": "3.0.0",
  "private": true,
  "description": "Adaptive MAP Growth Math style practice, as a static site with Google sign-in and Google Drive storage.",
  "scripts": {
    "build": "tsx scripts/build/build.ts",
    "dev": "tsx scripts/build/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/build/generate-questions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,html}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,html}": "prettier --write"
  }
}
